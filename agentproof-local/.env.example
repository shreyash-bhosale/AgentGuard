# Ollama Local Service Configuration
OLLAMA_URL=http://localhost:11434

# Default Local Model for Structured Proposals
DEFAULT_MODEL=gemma4:e2b-it-qat

# Request Timeout in Seconds (5 to 300)
REQUEST_TIMEOUT=60

# Local Directory for Exported Evaluation Reports
REPORTS_DIR=reports

# Cloud AI Provider Configuration (Options: gemma_cloud | gemma_openai | ollama)
AI_PROVIDER=gemma_cloud

# Cloud-Hosted Gemma 4 Model ID (e.g., gemma-4-26b-a4b-it or gemma-4-31b-it on Google AI Studio / Vertex AI)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Cloud Gemma API Key (Acquired from Google AI Studio or Vertex AI)
GEMMA_API_KEY=your_google_ai_studio_api_key_here

# Optional: Custom cloud endpoint for self-hosted OpenAI-compatible inference (e.g., vLLM / Cloud Run / HuggingFace)
# GEMMA_ENDPOINT=https://your-custom-gemma4-endpoint.run.app/v1

# Request Timeout in Seconds for AI inference
AI_REQUEST_TIMEOUT_SECONDS=30
